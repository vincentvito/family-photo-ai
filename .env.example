# Public canonical site URL — used by metadata, OG/Twitter cards, robots.txt,
# sitemap.xml, and any absolute-URL builders. No trailing slash.
# Production: https://familyshoot.com
NEXT_PUBLIC_SITE_URL=https://familyshoot.com

# Replicate token — serves BOTH Nano Banana Pro (google/nano-banana-pro) for
# photoreal generation + refinement, AND the stylized/upscale models.
# Grab one at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Set to "1" to skip all real API calls and return canned placeholder images.
# Useful for UI development without burning credits.
NEXT_PUBLIC_MOCK_MODE=0

# Cloudflare R2 (S3-compatible) — scoped token per bucket.
# CLOUDFLARE_BUCKET_API is the full S3 endpoint, e.g.
#   https://<accountid>.r2.cloudflarestorage.com
# CLOUDFLARE_PUBLIC_URL is the custom-domain CDN base for this bucket, e.g.
#   https://familyphotoai.cdn.clickstudio.ai
CLOUDFLARE_BUCKET_API=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=familyphotoai
CLOUDFLARE_PUBLIC_URL=

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET> when invoking
# /api/admin/cleanup-expired. Use a long random value in production.
CRON_SECRET=

# Stripe payments. Use test keys locally, then production keys in Vercel.
# STRIPE_SECRET_KEY starts with sk_test_ or sk_live_.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY starts with pk_test_ or pk_live_.
# STRIPE_WEBHOOK_SECRET starts with whsec_ after you create a webhook endpoint.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional explicit webhook URL for setup. Defaults to
# ${NEXT_PUBLIC_APP_URL}/api/stripe/webhook or
# ${NEXT_PUBLIC_SITE_URL}/api/stripe/webhook.
STRIPE_WEBHOOK_ENDPOINT_URL=

# One-time Stripe Price IDs for the pricing page packs.
STRIPE_PRICE_SINGLE_KEEPSAKE=
STRIPE_PRICE_THREE_PACK=
STRIPE_PRICE_EIGHT_PACK=

# Monthly subscription Price ID for FamilyShoot Pro ($39/month).
STRIPE_PRICE_FAMILYSHOOT_PRO_MONTHLY=

# Optional Stripe Customer Portal configuration ID created by
# npm run stripe:setup -- --create --portal. If unset, Stripe uses the
# account's default portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=
